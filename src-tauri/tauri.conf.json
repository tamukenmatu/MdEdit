{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MdEdit",
  "version": "1.0.0",
  "identifier": "com.mdedit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MdEdit",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "txt"],
        "name": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MzBEMkMwQUU2REI2NTQKUldSVXRtMnV3Tkl3RldkY0ZkVmdUOXgwQm03MHBlSzlLS01iS21GSTdQdFRvWTdrRVdLNWpHaUsK",
      "endpoints": [
        "https://github.com/tamukenmatu/MdEdit/releases/latest/download/latest.json"
      ]
    }
  }
}
